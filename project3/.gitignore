# Python bytecode
__pycache__/
*.pyc

# Experiment outputs (regenerated by extract_activations.py)
*.npz

# Run logs — transient. The durable, committed record is each run's results.json
# + runlog.md. Ignoring logs/ also avoids git-pull conflicts on the GPU box,
# which generates its own extraction logs under the same path.
logs/

# Virtual environment
.venv/

# Local model cache, if HF_HOME is pointed inside the repo
.cache/
models/

# macOS
.DS_Store
